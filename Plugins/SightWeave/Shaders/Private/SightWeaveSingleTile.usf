// SightWeave M3.1 formal shader path: Windows D3D12 SM6.

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

StructuredBuffer<float2> TriangleVertices;
StructuredBuffer<uint> TriangleIndices;
uint FirstIndex;
float InvPhysicalWorldSpan;
float RasterCentimetersPerTexel;
uint RasterTargetOriginX;
uint RasterTargetOriginY;

struct FSightWeaveRasterInterpolants
{
	float4 Position : SV_POSITION;
	nointerpolation float2 TriangleA : TEXCOORD0;
	nointerpolation float2 TriangleB : TEXCOORD1;
	nointerpolation float2 TriangleC : TEXCOORD2;
};

FSightWeaveRasterInterpolants SightWeaveSmokeVS(uint VertexId : SV_VertexID)
{
	const uint TriangleIndex = VertexId / 6;
	const uint QuadVertex = VertexId % 6;
	const uint CornerIndices[6] = { 0, 1, 2, 0, 2, 3 };
	const float2 A = TriangleVertices[TriangleIndices[FirstIndex + TriangleIndex * 3 + 0]];
	const float2 B = TriangleVertices[TriangleIndices[FirstIndex + TriangleIndex * 3 + 1]];
	const float2 C = TriangleVertices[TriangleIndices[FirstIndex + TriangleIndex * 3 + 2]];
	const float2 BoundsMin = min(A, min(B, C));
	const float2 BoundsMax = max(A, max(B, C));
	const float2 Corners[4] =
	{
		float2(BoundsMin.x, BoundsMin.y),
		float2(BoundsMax.x, BoundsMin.y),
		float2(BoundsMax.x, BoundsMax.y),
		float2(BoundsMin.x, BoundsMax.y)
	};
	const float2 Uv = Corners[CornerIndices[QuadVertex]] * InvPhysicalWorldSpan;
	FSightWeaveRasterInterpolants Output;
	// Texture row zero maps to the physical tile's minimum world Y.
	Output.Position = float4(Uv.x * 2.0f - 1.0f, 1.0f - Uv.y * 2.0f, 0.0f, 1.0f);
	Output.TriangleA = A;
	Output.TriangleB = B;
	Output.TriangleC = C;
	return Output;
}

float SightWeaveSmokePS(FSightWeaveRasterInterpolants Input) : SV_Target0
{
	const float2 TargetOrigin = float2(RasterTargetOriginX, RasterTargetOriginY);
	const float2 Point = (Input.Position.xy - TargetOrigin) * RasterCentimetersPerTexel;
	const float2 AB = Input.TriangleB - Input.TriangleA;
	const float2 BC = Input.TriangleC - Input.TriangleB;
	const float2 CA = Input.TriangleA - Input.TriangleC;
	const float Area = AB.x * (Input.TriangleC.y - Input.TriangleA.y)
		- AB.y * (Input.TriangleC.x - Input.TriangleA.x);
	const float Orientation = Area >= 0.0f ? 1.0f : -1.0f;
	const float E0 = Orientation * (AB.x * (Point.y - Input.TriangleA.y) - AB.y * (Point.x - Input.TriangleA.x));
	const float E1 = Orientation * (BC.x * (Point.y - Input.TriangleB.y) - BC.y * (Point.x - Input.TriangleB.x));
	const float E2 = Orientation * (CA.x * (Point.y - Input.TriangleC.y) - CA.y * (Point.x - Input.TriangleC.x));
	// Inclusive center-sample raster: epsilon is far below one world-space texel.
	if (E0 < -0.001f || E1 < -0.001f || E2 < -0.001f)
	{
		discard;
	}
	return 1.0f;
}

void SightWeaveFullscreenVS(
	uint VertexId : SV_VertexID,
	out float4 OutPosition : SV_POSITION)
{
	const float2 Positions[3] =
	{
		float2(-1.0f, -1.0f),
		float2(-1.0f, 3.0f),
		float2(3.0f, -1.0f)
	};
	OutPosition = float4(Positions[VertexId], 0.0f, 1.0f);
}

Texture2D<float> VisionTexture;
Texture2D<float> IlluminationTexture;
Texture2D<float> BypassTexture;
Texture2D<float> SuppressionTexture;
uint DestinationOriginX;
uint DestinationOriginY;

float SightWeaveCombinePS(float4 Position : SV_POSITION) : SV_Target0
{
	const int3 Texel = int3(int2(Position.xy), 0);
	const bool Gated = VisionTexture.Load(Texel) > 0.5f
		&& IlluminationTexture.Load(Texel) > 0.5f;
	const bool Effective = Gated || BypassTexture.Load(Texel) > 0.5f;
	const bool Suppressed = SuppressionTexture.Load(Texel) > 0.5f;
	return Effective && !Suppressed ? 1.0f : 0.0f;
}

float SightWeaveAtlasProfileCombinePS(float4 Position : SV_POSITION) : SV_Target0
{
	const int2 DestinationOrigin = int2(DestinationOriginX, DestinationOriginY);
	const int3 Texel = int3(int2(Position.xy) - DestinationOrigin, 0);
	return VisionTexture.Load(Texel) > 0.5f && IlluminationTexture.Load(Texel) > 0.5f
		? 1.0f
		: 0.0f;
}

float SightWeaveAtlasSuppressionPS(float4 Position : SV_POSITION) : SV_Target0
{
	const int2 DestinationOrigin = int2(DestinationOriginX, DestinationOriginY);
	const int3 Texel = int3(int2(Position.xy) - DestinationOrigin, 0);
	if (SuppressionTexture.Load(Texel) <= 0.5f)
	{
		discard;
	}
	return 0.0f;
}

Texture2D<float4> SceneColorTexture;
Texture2D<float> SceneDepthTexture;
Texture2D<float> SubjectProxyDepthTexture;
Texture2D<uint2> SubjectProxyStencilTexture;
uint SubjectProxyStencilValue;
float SubjectProxyNeutralIntensity;
StructuredBuffer<int4> PageTable;
Texture2D<float> AtlasPage0;
Texture2D<float> AtlasPage1;
Texture2D<float> AtlasPage2;
Texture2D<float> AtlasPage3;
int2 OutputRectMin;
int2 OutputRectSize;
int2 SceneColorRectMin;
int2 SceneColorRectSize;
float2 TemporalProjectionJitter;
uint DiagnosticMode;
uint UseStableDepthCoordinates;
float2 TranslatedFloorOrigin;
float CentimetersPerTexel;
uint PageTableCount;
StructuredBuffer<int4> MemoryPageTable;
Texture2D<float> MemoryPage0;
Texture2D<float> MemoryPage1;
uint MemoryPageTableCount;
StructuredBuffer<int4> StaticAttributePageTable;
Texture2D<float> StaticAttributePage0;
Texture2D<float> StaticAttributePage1;
uint StaticAttributePageTableCount;
float2 MemoryTranslatedFloorOrigin;
float MemoryTranslatedFloorPlaneZ;
float MemoryCentimetersPerTexel;
uint MemoryPresentationAvailable;
uint StaticEnvironmentStencilValue;
uint OccluderSurfaceStencilValue;
float RememberedBrightness;
float RememberedContrast;
float RememberedDetailStrength;
float RememberedDetailWorldScale;
float RememberedSurfaceDepthToleranceCentimeters;
float OccluderSurfaceBiasCentimeters;

static const uint SIGHTWEAVE_STATE_UNKNOWN = 0;
static const uint SIGHTWEAVE_STATE_REMEMBERED = 1;
static const uint SIGHTWEAVE_STATE_LIVE = 2;

bool SightWeaveCoordinateLess(int2 A, int2 B)
{
	return A.x < B.x || (A.x == B.x && A.y < B.y);
}

int SightWeaveFindPageTableEntry(int2 LogicalCoordinate)
{
	int Low = 0;
	int High = int(PageTableCount) - 1;
	while (Low <= High)
	{
		const int Middle = Low + (High - Low) / 2;
		const int2 Candidate = PageTable[Middle].xy;
		if (all(Candidate == LogicalCoordinate))
		{
			return Middle;
		}
		if (SightWeaveCoordinateLess(Candidate, LogicalCoordinate))
		{
			Low = Middle + 1;
		}
		else
		{
			High = Middle - 1;
		}
	}
	return -1;
}

float SightWeaveLoadAtlasMask(int PageIndex, int2 Texel)
{
	switch (PageIndex)
	{
	case 0: return AtlasPage0.Load(int3(Texel, 0));
	case 1: return AtlasPage1.Load(int3(Texel, 0));
	case 2: return AtlasPage2.Load(int3(Texel, 0));
	case 3: return AtlasPage3.Load(int3(Texel, 0));
	default: return 0.0f;
	}
}

int SightWeaveFloorDiv(int Value, int Divisor)
{
	int Quotient = Value / Divisor;
	const int Remainder = Value % Divisor;
	if (Remainder < 0)
	{
		--Quotient;
	}
	return Quotient;
}

bool SightWeaveIsHardLiveLogicalTexel(int2 LogicalTexel)
{
	const int2 LogicalCoordinate = int2(
		SightWeaveFloorDiv(LogicalTexel.x, 248),
		SightWeaveFloorDiv(LogicalTexel.y, 248));
	const int EntryIndex = SightWeaveFindPageTableEntry(LogicalCoordinate);
	if (EntryIndex < 0)
	{
		return false;
	}
	const int4 Entry = PageTable[EntryIndex];
	const int2 InteriorTexel = LogicalTexel - LogicalCoordinate * 248;
	const int2 SlotOrigin = int2(Entry.w & 7, Entry.w >> 3) * 256;
	return SightWeaveLoadAtlasMask(Entry.z, SlotOrigin + int2(4, 4) + InteriorTexel) >= 0.5f;
}

bool SightWeaveIsHardLive(float2 TranslatedWorld)
{
	const float2 LocalPosition = TranslatedWorld - TranslatedFloorOrigin;
	const float InteriorSpan = 248.0f * CentimetersPerTexel;
	const int2 LogicalCoordinate = int2(floor(LocalPosition / InteriorSpan));
	const int EntryIndex = SightWeaveFindPageTableEntry(LogicalCoordinate);
	if (EntryIndex < 0)
	{
		return false;
	}

	const int4 Entry = PageTable[EntryIndex];
	const int PageIndex = Entry.z;
	const int SlotIndex = Entry.w;
	const int2 SlotOrigin = int2(SlotIndex & 7, SlotIndex >> 3) * 256;
	const float2 TileLocal = LocalPosition - float2(LogicalCoordinate) * InteriorSpan;
	const int2 InteriorTexel = clamp(
		int2(floor(TileLocal / CentimetersPerTexel)),
		int2(0, 0),
		int2(247, 247));
	const int2 AtlasTexel = SlotOrigin + int2(4, 4) + InteriorTexel;
	return SightWeaveLoadAtlasMask(PageIndex, AtlasTexel) >= 0.5f;
}

int SightWeaveFindMemoryPageTableEntry(int2 LogicalCoordinate)
{
	int Low = 0;
	int High = int(MemoryPageTableCount) - 1;
	while (Low <= High)
	{
		const int Middle = Low + (High - Low) / 2;
		const int2 Candidate = MemoryPageTable[Middle].xy;
		if (all(Candidate == LogicalCoordinate)) return Middle;
		if (SightWeaveCoordinateLess(Candidate, LogicalCoordinate)) Low = Middle + 1;
		else High = Middle - 1;
	}
	return -1;
}

int SightWeaveFindStaticAttributePageTableEntry(int2 LogicalCoordinate)
{
	int Low = 0;
	int High = int(StaticAttributePageTableCount) - 1;
	while (Low <= High)
	{
		const int Middle = Low + (High - Low) / 2;
		const int2 Candidate = StaticAttributePageTable[Middle].xy;
		if (all(Candidate == LogicalCoordinate)) return Middle;
		if (SightWeaveCoordinateLess(Candidate, LogicalCoordinate)) Low = Middle + 1;
		else High = Middle - 1;
	}
	return -1;
}

float SightWeaveLoadMemoryPage(int PageIndex, int2 Texel)
{
	if (PageIndex == 0) return MemoryPage0.Load(int3(Texel, 0));
	if (PageIndex == 1) return MemoryPage1.Load(int3(Texel, 0));
	return 0.0f;
}

float SightWeaveLoadStaticAttributePage(int PageIndex, int2 Texel)
{
	if (PageIndex == 0) return StaticAttributePage0.Load(int3(Texel, 0));
	if (PageIndex == 1) return StaticAttributePage1.Load(int3(Texel, 0));
	return 0.0f;
}

float SightWeaveSampleMemory(float2 TranslatedWorld)
{
	const float2 Local = TranslatedWorld - MemoryTranslatedFloorOrigin;
	const float InteriorSpan = 248.0f * MemoryCentimetersPerTexel;
	const int2 LogicalCoordinate = int2(floor(Local / InteriorSpan));
	const int EntryIndex = SightWeaveFindMemoryPageTableEntry(LogicalCoordinate);
	if (EntryIndex < 0) return 0.0f;
	const int4 Entry = MemoryPageTable[EntryIndex];
	const int2 InteriorTexel = clamp(
		int2(floor((Local - float2(LogicalCoordinate) * InteriorSpan)
			/ MemoryCentimetersPerTexel)),
		int2(0, 0), int2(247, 247));
	const int2 SlotOrigin = int2(Entry.w & 7, Entry.w >> 3) * 256;
	return SightWeaveLoadMemoryPage(Entry.z, SlotOrigin + int2(4, 4) + InteriorTexel);
}

float SightWeaveSampleStaticAttribute(float2 TranslatedWorld)
{
	const float2 Local = TranslatedWorld - MemoryTranslatedFloorOrigin;
	const float InteriorSpan = 248.0f * MemoryCentimetersPerTexel;
	const int2 LogicalCoordinate = int2(floor(Local / InteriorSpan));
	const int EntryIndex = SightWeaveFindStaticAttributePageTableEntry(LogicalCoordinate);
	if (EntryIndex < 0) return 0.0f;
	const int4 Entry = StaticAttributePageTable[EntryIndex];
	const int2 InteriorTexel = clamp(
		int2(floor((Local - float2(LogicalCoordinate) * InteriorSpan)
			/ MemoryCentimetersPerTexel)),
		int2(0, 0), int2(247, 247));
	const int2 SlotOrigin = int2(Entry.w & 7, Entry.w >> 3) * 256;
	return SightWeaveLoadStaticAttributePage(
		Entry.z,
		SlotOrigin + int2(4, 4) + InteriorTexel);
}

bool SightWeaveIsRememberedEligible(float2 TranslatedWorld)
{
	return MemoryPresentationAvailable != 0
		&& MemoryPageTableCount != 0
		&& StaticAttributePageTableCount != 0
		&& SightWeaveSampleMemory(TranslatedWorld) >= 0.5f
		&& SightWeaveSampleStaticAttribute(TranslatedWorld) > 0.0f;
}

uint SightWeaveResolvePresentationState(
	bool bHardLive,
	bool bRememberedEligible)
{
	if (bHardLive)
	{
		return SIGHTWEAVE_STATE_LIVE;
	}
	return bRememberedEligible
		? SIGHTWEAVE_STATE_REMEMBERED
		: SIGHTWEAVE_STATE_UNKNOWN;
}

bool SightWeaveSampleRememberedSurface(
	int2 CustomDepthPixel,
	float2 SceneSvPosition,
	float SceneDeviceZ,
	out float3 TranslatedSurfaceWorld,
	out uint SurfaceStencil)
{
	SurfaceStencil = SubjectProxyStencilTexture.Load(int3(CustomDepthPixel, 0))
		STENCIL_COMPONENT_SWIZZLE;
	if (SurfaceStencil != StaticEnvironmentStencilValue
		&& SurfaceStencil != OccluderSurfaceStencilValue)
	{
		TranslatedSurfaceWorld = 0.0f;
		return false;
	}
	const float SurfaceDeviceZ = SubjectProxyDepthTexture.Load(int3(CustomDepthPixel, 0));
	const float SceneDepthCentimeters = ConvertFromDeviceZ(SceneDeviceZ);
	const float SurfaceDepthCentimeters = ConvertFromDeviceZ(SurfaceDeviceZ);
	if (!isfinite(SceneDepthCentimeters)
		|| !isfinite(SurfaceDepthCentimeters)
		|| abs(SceneDepthCentimeters - SurfaceDepthCentimeters)
			> RememberedSurfaceDepthToleranceCentimeters)
	{
		TranslatedSurfaceWorld = 0.0f;
		return false;
	}
	TranslatedSurfaceWorld = SvPositionToTranslatedWorld(
		float4(SceneSvPosition, SurfaceDeviceZ, 1.0f));
	return all(isfinite(TranslatedSurfaceWorld));
}

bool SightWeaveIsHardLiveForSurface(
	float2 TranslatedWorld,
	uint SurfaceStencil)
{
	if (SightWeaveIsHardLive(TranslatedWorld))
	{
		return true;
	}
	if (SurfaceStencil != OccluderSurfaceStencilValue
		|| OccluderSurfaceBiasCentimeters <= 0.0f)
	{
		return false;
	}
	const float Bias = OccluderSurfaceBiasCentimeters;
	return SightWeaveIsHardLive(TranslatedWorld + float2(Bias, 0.0f))
		|| SightWeaveIsHardLive(TranslatedWorld + float2(-Bias, 0.0f))
		|| SightWeaveIsHardLive(TranslatedWorld + float2(0.0f, Bias))
		|| SightWeaveIsHardLive(TranslatedWorld + float2(0.0f, -Bias));
}

bool SightWeaveIsRememberedEligibleForSurface(
	float2 TranslatedWorld,
	uint SurfaceStencil)
{
	if (SightWeaveIsRememberedEligible(TranslatedWorld))
	{
		return true;
	}
	if (SurfaceStencil != OccluderSurfaceStencilValue
		|| OccluderSurfaceBiasCentimeters <= 0.0f
		|| MemoryPresentationAvailable == 0
		|| SightWeaveSampleStaticAttribute(TranslatedWorld) <= 0.0f)
	{
		return false;
	}
	const float Bias = OccluderSurfaceBiasCentimeters;
	return SightWeaveSampleMemory(TranslatedWorld + float2(Bias, 0.0f)) >= 0.5f
		|| SightWeaveSampleMemory(TranslatedWorld + float2(-Bias, 0.0f)) >= 0.5f
		|| SightWeaveSampleMemory(TranslatedWorld + float2(0.0f, Bias)) >= 0.5f
		|| SightWeaveSampleMemory(TranslatedWorld + float2(0.0f, -Bias)) >= 0.5f;
}

float4 SightWeaveRememberedSurfaceColor(
	float3 TranslatedSurfaceWorld,
	uint SurfaceStencil)
{
	const float Attribute = SightWeaveSampleStaticAttribute(TranslatedSurfaceWorld.xy);
	const float3 Ddx = ddx(TranslatedSurfaceWorld);
	const float3 Ddy = ddy(TranslatedSurfaceWorld);
	const float3 SurfaceCross = cross(Ddx, Ddy);
	const float SurfaceCrossLengthSquared = dot(SurfaceCross, SurfaceCross);
	const float TopFacing = SurfaceCrossLengthSquared > 1.0e-8f
		? abs(SurfaceCross.z) * rsqrt(SurfaceCrossLengthSquared)
		: 1.0f;
	const float OccluderClass = SurfaceStencil == OccluderSurfaceStencilValue
		? 1.0f
		: 0.0f;
	const float2 StableWorld =
		(TranslatedSurfaceWorld.xy - MemoryTranslatedFloorOrigin)
		/ max(RememberedDetailWorldScale, 1.0f);
	const float2 Cell = abs(frac(StableWorld) - 0.5f);
	const float CellDetail = (Cell.x + Cell.y) - 0.5f;
	const float GeometryDetail = lerp(TopFacing - 0.5f, 0.5f - TopFacing, OccluderClass);
	const float Neutral = RememberedBrightness
		+ (Attribute - 0.5f) * RememberedContrast
		+ (CellDetail * 0.65f + GeometryDetail * 0.35f) * RememberedDetailStrength;
	return float4(saturate(Neutral).xxx, 1.0f);
}

bool SightWeaveIntersectFloorPlane(int2 DepthPixel, out float2 TranslatedFloorPosition)
{
	const float3 A = SvPositionToTranslatedWorld(
		float4(float2(DepthPixel) + 0.5f, 0.5f, 1.0f));
	const float3 B = SvPositionToTranslatedWorld(
		float4(float2(DepthPixel) + 0.5f, 0.1f, 1.0f));
	const float3 Direction = B - A;
	if (abs(Direction.z) < 1.0e-6f)
	{
		TranslatedFloorPosition = 0.0f;
		return false;
	}
	const float T = (MemoryTranslatedFloorPlaneZ - A.z) / Direction.z;
	TranslatedFloorPosition = A.xy + Direction.xy * T;
	return all(isfinite(TranslatedFloorPosition));
}

float4 SightWeaveRememberedEnvironment(int2 DepthPixel)
{
	if (MemoryPresentationAvailable == 0
		|| MemoryPageTableCount == 0
		|| StaticAttributePageTableCount == 0)
	{
		return 0.0f;
	}
	float2 TranslatedFloorPosition;
	if (!SightWeaveIntersectFloorPlane(DepthPixel, TranslatedFloorPosition)
		|| SightWeaveSampleMemory(TranslatedFloorPosition) < 0.5f)
	{
		return 0.0f;
	}
	const float Attribute = SightWeaveSampleStaticAttribute(TranslatedFloorPosition);
	return Attribute > 0.0f ? float4(Attribute.xxx, 1.0f) : 0.0f;
}

bool SightWeaveIsVisibleSubjectProxy(int2 CustomDepthPixel, float SceneDeviceZ)
{
	const uint Stencil = SubjectProxyStencilTexture.Load(int3(CustomDepthPixel, 0))
		STENCIL_COMPONENT_SWIZZLE;
	if (Stencil != SubjectProxyStencilValue)
	{
		return false;
	}
	const float ProxyDeviceZ = SubjectProxyDepthTexture.Load(int3(CustomDepthPixel, 0));
	// Unreal's reversed-Z device depth is larger for geometry closer to the camera.
	return ProxyDeviceZ + 1.0e-6f >= SceneDeviceZ;
}

void SightWeaveResolveDepthCoordinates(
	float2 ViewUv,
	out int2 StableDepthPixel,
	out int2 SceneDepthPixel,
	out float2 SceneSvPosition)
{
	const int2 DepthRectMin = int2(View.ViewRectMinAndSize.xy);
	const int2 DepthRectSize = int2(View.ViewRectMinAndSize.zw);
	StableDepthPixel = clamp(
		DepthRectMin + int2(ViewUv * float2(DepthRectSize)),
		DepthRectMin,
		DepthRectMin + DepthRectSize - 1);
	SceneSvPosition = float2(StableDepthPixel) + 0.5f;
	SceneDepthPixel = StableDepthPixel;
	if (UseStableDepthCoordinates != 0)
	{
		SceneSvPosition += float2(
			TemporalProjectionJitter.x * float(DepthRectSize.x) * 0.5f,
			TemporalProjectionJitter.y * float(DepthRectSize.y) * -0.5f);
		SceneDepthPixel = clamp(
			int2(floor(SceneSvPosition)),
			DepthRectMin,
			DepthRectMin + DepthRectSize - 1);
	}
}

float4 SightWeaveDebugWorldPosition(float3 TranslatedWorld)
{
	const float3 Stable = abs(frac(TranslatedWorld / 250.0f) - 0.5f) * 2.0f;
	return float4(Stable, 1.0f);
}

float4 SightWeaveDebugCustomDepth(int2 CustomDepthPixel)
{
	const float DeviceZ = SubjectProxyDepthTexture.Load(int3(CustomDepthPixel, 0));
	const float LinearDepth = ConvertFromDeviceZ(DeviceZ);
	return float4((1.0f - saturate(LinearDepth / 5000.0f)).xxx, 1.0f);
}

float4 SightWeaveDebugCustomStencil(int2 CustomDepthPixel)
{
	const uint Stencil = SubjectProxyStencilTexture.Load(int3(CustomDepthPixel, 0))
		STENCIL_COMPONENT_SWIZZLE;
	if (Stencil == StaticEnvironmentStencilValue) return float4(0.15f, 0.45f, 1.0f, 1.0f);
	if (Stencil == OccluderSurfaceStencilValue) return float4(1.0f, 0.45f, 0.1f, 1.0f);
	if (Stencil == SubjectProxyStencilValue) return float4(1.0f, 0.0f, 0.75f, 1.0f);
	return 0.0f;
}

float4 SightWeaveDebugMemory(float2 TranslatedWorld)
{
	const float Memory = SightWeaveSampleMemory(TranslatedWorld);
	return float4(Memory.xxx, 1.0f);
}

float4 SightWeaveDebugStaticAttribute(float2 TranslatedWorld)
{
	const float Attribute = SightWeaveSampleStaticAttribute(TranslatedWorld);
	return float4(Attribute.xxx, 1.0f);
}

float4 SightWeaveSubjectProxyNeutral()
{
	return float4(SubjectProxyNeutralIntensity.xxx, 1.0f);
}

float4 SightWeaveHardMaskCompositePS(float4 Position : SV_POSITION) : SV_Target0
{
	const int2 OutputPixel = int2(Position.xy);
	const float2 ViewUv = saturate(
		(float2(OutputPixel - OutputRectMin) + 0.5f) / float2(OutputRectSize));
	const int2 SceneColorPixel = clamp(
		SceneColorRectMin + int2(ViewUv * float2(SceneColorRectSize)),
		SceneColorRectMin,
		SceneColorRectMin + SceneColorRectSize - 1);
	int2 DepthPixel;
	int2 SceneDepthPixel;
	float2 SceneSvPosition;
	SightWeaveResolveDepthCoordinates(ViewUv, DepthPixel, SceneDepthPixel, SceneSvPosition);
	const float DeviceZ = SceneDepthTexture.Load(int3(SceneDepthPixel, 0));
	const float3 TranslatedWorld = SvPositionToTranslatedWorld(
		float4(SceneSvPosition, DeviceZ, 1.0f));
	if (DiagnosticMode == 5) return SightWeaveDebugWorldPosition(TranslatedWorld);
	if (DiagnosticMode == 6) return SightWeaveDebugCustomDepth(DepthPixel);
	if (DiagnosticMode == 7) return SightWeaveDebugCustomStencil(DepthPixel);
	if (DiagnosticMode == 9) return SightWeaveDebugMemory(TranslatedWorld.xy);
	if (DiagnosticMode == 10) return SightWeaveDebugStaticAttribute(TranslatedWorld.xy);
	float3 TranslatedSurfaceWorld;
	uint SurfaceStencil;
	bool bRememberedSurface = DiagnosticMode != 2
		&& DiagnosticMode != 3
		&& SightWeaveSampleRememberedSurface(
			DepthPixel,
			SceneSvPosition,
			DeviceZ,
			TranslatedSurfaceWorld,
			SurfaceStencil);
	if (DiagnosticMode == 3)
	{
		TranslatedSurfaceWorld = TranslatedWorld;
		SurfaceStencil = StaticEnvironmentStencilValue;
		bRememberedSurface = true;
	}
	const float2 VisibilityWorld = bRememberedSurface
		? TranslatedSurfaceWorld.xy
		: TranslatedWorld.xy;
	const bool bHardLive = SightWeaveIsHardLiveForSurface(
		VisibilityWorld,
		bRememberedSurface ? SurfaceStencil : 0);
	const bool bRememberedEligible = bRememberedSurface
		&& SightWeaveIsRememberedEligibleForSurface(
			TranslatedSurfaceWorld.xy,
			SurfaceStencil);
	const uint State = SightWeaveResolvePresentationState(
		bHardLive,
		bRememberedEligible);
	if (DiagnosticMode == 4)
	{
		return State == SIGHTWEAVE_STATE_LIVE
			? 1.0f
			: (State == SIGHTWEAVE_STATE_REMEMBERED ? 0.35f : 0.0f);
	}
	if (State == SIGHTWEAVE_STATE_LIVE)
	{
		return SceneColorTexture.Load(int3(SceneColorPixel, 0));
	}
	return SightWeaveIsVisibleSubjectProxy(DepthPixel, DeviceZ)
		? SightWeaveSubjectProxyNeutral()
		: (State == SIGHTWEAVE_STATE_REMEMBERED
			? SightWeaveRememberedSurfaceColor(
				TranslatedSurfaceWorld,
				SurfaceStencil)
			: 0.0f);
}

Texture2D<float> FeatherPage0;
Texture2D<float> FeatherPage1;
Texture2D<float> FeatherPage2;
Texture2D<float> FeatherPage3;
Texture2D<float2> FeatherSeedTexture;
int2 FeatherWorkOrigin;
int2 FeatherLogicalTile;
int FeatherJumpStep;
uint FeatherWorkSize;
float FeatherWidthCentimeters;

float SightWeaveLoadFeatherAtlas(int PageIndex, int2 Texel)
{
	switch (PageIndex)
	{
	case 0: return FeatherPage0.Load(int3(Texel, 0));
	case 1: return FeatherPage1.Load(int3(Texel, 0));
	case 2: return FeatherPage2.Load(int3(Texel, 0));
	case 3: return FeatherPage3.Load(int3(Texel, 0));
	default: return 0.0f;
	}
}

float SightWeaveLoadFeatherLogicalTexel(int2 LogicalTexel)
{
	const int2 LogicalCoordinate = int2(
		SightWeaveFloorDiv(LogicalTexel.x, 248),
		SightWeaveFloorDiv(LogicalTexel.y, 248));
	const int EntryIndex = SightWeaveFindPageTableEntry(LogicalCoordinate);
	if (EntryIndex < 0)
	{
		return 0.0f;
	}
	const int4 Entry = PageTable[EntryIndex];
	const int2 InteriorTexel = LogicalTexel - LogicalCoordinate * 248;
	const int2 SlotOrigin = int2(Entry.w & 7, Entry.w >> 3) * 256;
	return SightWeaveLoadFeatherAtlas(
		Entry.z,
		SlotOrigin + int2(4, 4) + InteriorTexel);
}

float SightWeaveSampleVisualFeather(float2 LocalPosition)
{
	const float2 CenterGrid = LocalPosition / CentimetersPerTexel - 0.5f;
	const int2 Base = int2(floor(CenterGrid));
	const float2 Fraction = frac(CenterGrid);
	const float W00 = SightWeaveLoadFeatherLogicalTexel(Base);
	const float W10 = SightWeaveLoadFeatherLogicalTexel(Base + int2(1, 0));
	const float W01 = SightWeaveLoadFeatherLogicalTexel(Base + int2(0, 1));
	const float W11 = SightWeaveLoadFeatherLogicalTexel(Base + int2(1, 1));
	return saturate(lerp(lerp(W00, W10, Fraction.x), lerp(W01, W11, Fraction.x), Fraction.y));
}

float2 SightWeaveFeatherSeedPS(float4 Position : SV_POSITION) : SV_Target0
{
	const int2 WorkTexel = clamp(int2(Position.xy), int2(0, 0), int(FeatherWorkSize) - 1);
	const int2 LogicalTexel = FeatherWorkOrigin + WorkTexel;
	return SightWeaveIsHardLiveLogicalTexel(LogicalTexel)
		? float2(1.0e20f, 1.0e20f)
		: float2(LogicalTexel);
}

float2 SightWeaveFeatherJumpPS(float4 Position : SV_POSITION) : SV_Target0
{
	const int2 WorkTexel = clamp(int2(Position.xy), int2(0, 0), int(FeatherWorkSize) - 1);
	const float2 LogicalTexel = float2(FeatherWorkOrigin + WorkTexel);
	float2 BestSeed = FeatherSeedTexture.Load(int3(WorkTexel, 0));
	float BestDistanceSquared = dot(BestSeed - LogicalTexel, BestSeed - LogicalTexel);
	[unroll]
	for (int OffsetY = -1; OffsetY <= 1; ++OffsetY)
	{
		[unroll]
		for (int OffsetX = -1; OffsetX <= 1; ++OffsetX)
		{
			const int2 CandidateTexel = clamp(
				WorkTexel + int2(OffsetX, OffsetY) * FeatherJumpStep,
				int2(0, 0),
				int(FeatherWorkSize) - 1);
			const float2 Candidate = FeatherSeedTexture.Load(int3(CandidateTexel, 0));
			const float CandidateDistanceSquared = dot(
				Candidate - LogicalTexel,
				Candidate - LogicalTexel);
			if (CandidateDistanceSquared < BestDistanceSquared)
			{
				BestSeed = Candidate;
				BestDistanceSquared = CandidateDistanceSquared;
			}
		}
	}
	return BestSeed;
}

float SightWeaveFeatherFinalizePS(float4 Position : SV_POSITION) : SV_Target0
{
	const int2 DestinationOrigin = int2(DestinationOriginX, DestinationOriginY) + int2(4, 4);
	const int2 InteriorTexel = clamp(int2(Position.xy) - DestinationOrigin, int2(0, 0), int2(247, 247));
	const int2 LogicalTexel = FeatherLogicalTile * 248 + InteriorTexel;
	if (!SightWeaveIsHardLiveLogicalTexel(LogicalTexel))
	{
		return 0.0f;
	}
	const int2 WorkTexel = InteriorTexel + int2(40, 40);
	const float2 Seed = FeatherSeedTexture.Load(int3(WorkTexel, 0));
	if (Seed.x > 1.0e10f || Seed.y > 1.0e10f)
	{
		return 1.0f;
	}
	const float DistanceCentimeters = length(Seed - float2(LogicalTexel)) * CentimetersPerTexel;
	return saturate(DistanceCentimeters / max(FeatherWidthCentimeters, 0.0001f));
}

float4 SightWeaveInwardFeatherCompositePS(float4 Position : SV_POSITION) : SV_Target0
{
	const int2 OutputPixel = int2(Position.xy);
	const float2 ViewUv = saturate(
		(float2(OutputPixel - OutputRectMin) + 0.5f) / float2(OutputRectSize));
	const int2 SceneColorPixel = clamp(
		SceneColorRectMin + int2(ViewUv * float2(SceneColorRectSize)),
		SceneColorRectMin,
		SceneColorRectMin + SceneColorRectSize - 1);
	int2 DepthPixel;
	int2 SceneDepthPixel;
	float2 SceneSvPosition;
	SightWeaveResolveDepthCoordinates(ViewUv, DepthPixel, SceneDepthPixel, SceneSvPosition);
	const float DeviceZ = SceneDepthTexture.Load(int3(SceneDepthPixel, 0));
	const float3 TranslatedWorld = SvPositionToTranslatedWorld(
		float4(SceneSvPosition, DeviceZ, 1.0f));
	if (DiagnosticMode == 5) return SightWeaveDebugWorldPosition(TranslatedWorld);
	if (DiagnosticMode == 6) return SightWeaveDebugCustomDepth(DepthPixel);
	if (DiagnosticMode == 7) return SightWeaveDebugCustomStencil(DepthPixel);
	if (DiagnosticMode == 9) return SightWeaveDebugMemory(TranslatedWorld.xy);
	if (DiagnosticMode == 10) return SightWeaveDebugStaticAttribute(TranslatedWorld.xy);
	float3 TranslatedSurfaceWorld;
	uint SurfaceStencil;
	bool bRememberedSurface = DiagnosticMode != 2
		&& DiagnosticMode != 3
		&& SightWeaveSampleRememberedSurface(
			DepthPixel,
			SceneSvPosition,
			DeviceZ,
			TranslatedSurfaceWorld,
			SurfaceStencil);
	if (DiagnosticMode == 3)
	{
		TranslatedSurfaceWorld = TranslatedWorld;
		SurfaceStencil = StaticEnvironmentStencilValue;
		bRememberedSurface = true;
	}
	const float2 VisibilityWorld = bRememberedSurface
		? TranslatedSurfaceWorld.xy
		: TranslatedWorld.xy;
	const bool bHardLive = SightWeaveIsHardLiveForSurface(
		VisibilityWorld,
		bRememberedSurface ? SurfaceStencil : 0);
	const bool bRememberedEligible = bRememberedSurface
		&& SightWeaveIsRememberedEligibleForSurface(
			TranslatedSurfaceWorld.xy,
			SurfaceStencil);
	const uint State = SightWeaveResolvePresentationState(
		bHardLive,
		bRememberedEligible);
	if (DiagnosticMode == 4)
	{
		return State == SIGHTWEAVE_STATE_LIVE
			? 1.0f
			: (State == SIGHTWEAVE_STATE_REMEMBERED ? 0.35f : 0.0f);
	}
	if (State != SIGHTWEAVE_STATE_LIVE)
	{
		return SightWeaveIsVisibleSubjectProxy(DepthPixel, DeviceZ)
			? SightWeaveSubjectProxyNeutral()
			: (State == SIGHTWEAVE_STATE_REMEMBERED
				? SightWeaveRememberedSurfaceColor(
					TranslatedSurfaceWorld,
					SurfaceStencil)
				: 0.0f);
	}
	const float VisualFeatherWeight = SightWeaveSampleVisualFeather(
		VisibilityWorld - TranslatedFloorOrigin);
	const float4 LowerPriorityState = bRememberedEligible
		? SightWeaveRememberedSurfaceColor(TranslatedSurfaceWorld, SurfaceStencil)
		: 0.0f;
	return lerp(
		LowerPriorityState,
		SceneColorTexture.Load(int3(SceneColorPixel, 0)),
		VisualFeatherWeight);
}

StructuredBuffer<float2> TestTranslatedWorldPositions;
StructuredBuffer<float4> TestSceneColors;
uint TestSampleCount;

float4 SightWeaveMemoryPresentationTestPS(float4 Position : SV_POSITION) : SV_Target0
{
	const uint SampleIndex = uint(Position.x);
	if (SampleIndex >= TestSampleCount)
	{
		return 0.0f;
	}
	const float2 TranslatedWorld = TestTranslatedWorldPositions[SampleIndex];
	const uint State = SightWeaveResolvePresentationState(
		SightWeaveIsHardLive(TranslatedWorld),
		SightWeaveIsRememberedEligible(TranslatedWorld));
	if (State == SIGHTWEAVE_STATE_LIVE)
	{
		return TestSceneColors[SampleIndex];
	}
	if (State != SIGHTWEAVE_STATE_REMEMBERED)
	{
		return 0.0f;
	}
	const float Attribute = SightWeaveSampleStaticAttribute(TranslatedWorld);
	return Attribute > 0.0f ? float4(Attribute.xxx, 1.0f) : 0.0f;
}

float4 SightWeavePresentationTestPS(float4 Position : SV_POSITION) : SV_Target0
{
	const uint SampleIndex = uint(Position.x);
	if (SampleIndex >= TestSampleCount)
	{
		return 0.0f;
	}
	return SightWeaveIsHardLive(TestTranslatedWorldPositions[SampleIndex])
		? TestSceneColors[SampleIndex]
		: 0.0f;
}

float4 SightWeaveFeatherPresentationTestPS(float4 Position : SV_POSITION) : SV_Target0
{
	const uint SampleIndex = uint(Position.x);
	if (SampleIndex >= TestSampleCount)
	{
		return 0.0f;
	}
	const float2 TranslatedWorld = TestTranslatedWorldPositions[SampleIndex];
	if (!SightWeaveIsHardLive(TranslatedWorld))
	{
		return 0.0f;
	}
	const float Weight = SightWeaveSampleVisualFeather(TranslatedWorld - TranslatedFloorOrigin);
	return TestSceneColors[SampleIndex] * Weight;
}

float2 TestWorldMin;
float2 TestWorldStep;
int2 TestOutputExtent;

float4 SightWeavePresentationBenchmarkPS(float4 Position : SV_POSITION) : SV_Target0
{
	const int2 Pixel = clamp(int2(Position.xy), int2(0, 0), TestOutputExtent - 1);
	const float2 TranslatedWorld = TestWorldMin + (float2(Pixel) + 0.5f) * TestWorldStep;
	const float2 Gradient = (float2(Pixel) + 0.5f) / float2(TestOutputExtent);
	const float4 SceneColor = float4(Gradient.x, Gradient.y, 0.5f, 1.0f);
	return SightWeaveIsHardLive(TranslatedWorld) ? SceneColor : 0.0f;
}

float4 SightWeaveFeatherPresentationBenchmarkPS(float4 Position : SV_POSITION) : SV_Target0
{
	const int2 Pixel = clamp(int2(Position.xy), int2(0, 0), TestOutputExtent - 1);
	const float2 TranslatedWorld = TestWorldMin + (float2(Pixel) + 0.5f) * TestWorldStep;
	if (!SightWeaveIsHardLive(TranslatedWorld))
	{
		return 0.0f;
	}
	const float2 Gradient = (float2(Pixel) + 0.5f) / float2(TestOutputExtent);
	const float4 SceneColor = float4(Gradient.x, Gradient.y, 0.5f, 1.0f);
	return SceneColor * SightWeaveSampleVisualFeather(TranslatedWorld - TranslatedFloorOrigin);
}
