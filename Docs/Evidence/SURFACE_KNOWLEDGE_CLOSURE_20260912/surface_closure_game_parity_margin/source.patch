+  if(BlockedValid)
+  {
+   auto Shadow=ClipFace(Receiver,Face,Blocked,-Margin);
+   if(Shadow.Polygon.Num()>=3)Out.BlockedShadows.Add(MoveTemp(Shadow));
+  }
+ }
